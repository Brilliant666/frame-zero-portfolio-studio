# REQUIRED / NON_SECRET. Copy outside Git, replace the release placeholder,
# validate it, and pass it explicitly with docker compose --env-file.
PORTFOLIO_DEPLOYMENT_MODE=production
PORTFOLIO_DOMAIN=photo.cosflow.icu
PORTFOLIO_RELEASE=replace-with-reviewed-git-sha
PORTFOLIO_BIND_ADDRESS=0.0.0.0
PORTFOLIO_HTTP_PORT=80
PORTFOLIO_HTTPS_PORT=443
PORTFOLIO_CADDY_CONFIG=Caddyfile

# OPTIONAL / NON_SECRET. INFO is the safe default when omitted.
PORTFOLIO_LOG_LEVEL=INFO

# SECRET: none are accepted by the Stage A2 deployment contract. Future
# credentials must use a separately reviewed server-side injection mechanism.
