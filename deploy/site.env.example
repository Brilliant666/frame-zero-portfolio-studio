# Topology parameters only. Keep actual secret files outside the checkout.
# Replace the immutable release and prepare authorized data before using this.
PORTFOLIO_SITE_MODE=production
PORTFOLIO_RELEASE=change-me
PORTFOLIO_SITE_ORIGIN=https://photography.example.com
PORTFOLIO_SITE_DOMAIN=photography.example.com
PORTFOLIO_SITE_HOST=photography.example.com
PORTFOLIO_SITE_CADDY_CONFIG=site.production.caddy
# This optional host mapping can sit behind an existing reverse proxy.
# Omit site.ports.yaml entirely when using an explicit Docker ingress network.
PORTFOLIO_SITE_BIND_ADDRESS=127.0.0.1
PORTFOLIO_SITE_HTTP_PORT=8080
PORTFOLIO_SITE_HTTPS_PORT=8443
# App URL uses a distinct non-superuser DML role such as portfolio_app.
# Keep the bootstrap administrator password separate; never mount it in app.
PORTFOLIO_DATABASE_URL_FILE=/srv/portfolio-config/database-url
PORTFOLIO_ACCOUNT_SECRET_FILE=/srv/portfolio-config/account-secret
# Only the PostgreSQL container receives this bootstrap administrator secret.
PORTFOLIO_POSTGRES_PASSWORD_FILE=/srv/portfolio-config/postgres-password
PORTFOLIO_LOG_LEVEL=INFO
