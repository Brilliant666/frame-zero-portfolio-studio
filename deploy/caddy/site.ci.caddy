{
	admin off
	local_certs
	skip_install_trust
	servers {
		enable_full_duplex
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
	log default {
		output stdout
		format json
		level {$PORTFOLIO_LOG_LEVEL:INFO}
	}
}

import /etc/caddy/site-proxy.caddy

{$PORTFOLIO_SITE_DOMAIN} {
	tls internal
	import portfolio_site_contract
}
