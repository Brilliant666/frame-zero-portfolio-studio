{
  "name": "frame-zero-portfolio-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "vinext dev --hostname 127.0.0.1 --port 3001",
    "build": "node scripts/build-next-node.mjs",
    "build:node": "npm run build",
    "build:legacy": "vinext build",
    "preview": "npm run start",
    "start": "node .next/standalone/server.js",
    "start:node": "npm run start",
    "start:legacy": "vinext start",
    "test": "npm run check:public && npm run test:contracts && npm run test:migrations && npm run test:adapters && npm run test:photos && npm run test:layouts && npm run test:materials && npm run test:composition && npm run test:preview && npm run test:admin && npm run test:polish && npm run test:container-contract && npm run test:deployment-config && npm run test:deployment-bootstrap && npm run test:deployment-operations && npm run test:legacy-runtime && npm run test:node-runtime",
    "test:contracts": "node --test tests/site-document.test.mjs",
    "test:migrations": "node --test tests/stable-id-migration.test.mjs",
    "test:adapters": "node --test tests/legacy-site-content-adapter.test.mjs",
    "test:photos": "node --test tests/photo-import.test.mjs tests/photo-import-service.test.mjs tests/dev-local.test.mjs tests/photo-import-client.test.mjs tests/photo-library-management.test.mjs",
    "test:layouts": "node --test tests/photo-layout.test.mjs",
    "test:materials": "node --test tests/template-material-profiles.test.mjs",
    "test:composition": "node --test tests/template-composition.test.mjs",
    "test:preview": "node --test tests/template-preview-composition.test.mjs",
    "test:admin": "node --test tests/admin-state.test.mjs tests/admin-v2.test.mjs",
    "test:polish": "node --test tests/client-visible-title.test.mjs tests/orbital-portal-focus.test.mjs tests/polaroid-field-fit.test.mjs",
    "test:container-contract": "node --test tests/container-packaging.test.mjs",
    "test:deployment-config": "node --test tests/deployment-config.test.mjs",
    "test:deployment-bootstrap": "node --test tests/deployment-bootstrap.test.mjs",
    "test:deployment-operations": "node --test tests/deployment-operations.test.mjs",
    "test:legacy-runtime": "npm run build:legacy && npm run check:bundle:legacy && node --test tests/rendered-html.test.mjs tests/admin-rendered-html.test.mjs tests/site-content-api.test.mjs",
    "test:node-runtime": "npm run build && npm run check:bundle && node --test tests/next-node-runtime.test.mjs tests/legacy-build-budget.test.mjs",
    "photos:import": "node scripts/import-photo-library.mjs",
    "photos:serve": "node scripts/photo-import-server.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:assets": "npm run check:public",
    "check:bundle": "node scripts/check-next-build-budget.mjs",
    "check:bundle:node": "npm run check:bundle",
    "check:bundle:legacy": "node scripts/check-build-budget.mjs",
    "check:public": "node scripts/check-public-safety.mjs",
    "verify:container": "node scripts/verify-production-container.mjs",
    "deployment:validate": "node scripts/validate-deployment-config.mjs",
    "deployment:bootstrap": "node scripts/deployment-bootstrap.mjs",
    "verify:deployment-bootstrap": "node scripts/verify-deployment-bootstrap.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
