{
  "name": "frame-zero-portfolio-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1 --port 3001",
    "build": "vinext build",
    "preview": "vinext dev --hostname 127.0.0.1 --port 3001",
    "start": "vinext start",
    "test": "npm run check:public && npm run test:contracts && npm run test:migrations && npm run test:adapters && npm run test:photos && npm run test:layouts && npm run test:admin && npm run build && npm run check:bundle && node --test tests/rendered-html.test.mjs tests/site-content-api.test.mjs",
    "test:contracts": "node --test tests/site-document.test.mjs",
    "test:migrations": "node --test tests/stable-id-migration.test.mjs",
    "test:adapters": "node --test tests/legacy-site-content-adapter.test.mjs",
    "test:photos": "node --test tests/photo-import.test.mjs",
    "test:layouts": "node --test tests/photo-layout.test.mjs",
    "test:admin": "node --test tests/admin-state.test.mjs",
    "photos:import": "node scripts/import-photo-library.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:assets": "npm run check:public",
    "check:bundle": "node scripts/check-build-budget.mjs",
    "check:public": "node scripts/check-public-safety.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
